{
  "name": "@local/dsh-epub-reader",
  "version": "2.6.10",
  "private": true,
  "description": "AI Book Shelf: read books, papers, and dossiers in Harness; full-text search, AI explanations and follow-ups, paper translation, bilingual compare, dossier skills and AI summaries.",
  "keywords": [
    "dsh-plugin",
    "ai-book-shelf",
    "book-shelf",
    "paper-reader",
    "paper-translation",
    "epub",
    "pdf",
    "reader",
    "ai",
    "deepseek-harness",
    "dossier",
    "dossier-mode",
    "case-file"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/0avatar0/dsh-ai-book-shelf.git"
  },
  "homepage": "https://github.com/0avatar0/dsh-ai-book-shelf",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "vendor/pdfjs/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
